# --- Mistral API -------------------------------------------------------------
# Single key for generation and embeddings.
MISTRAL_API_KEY=

# Model identifiers. Verify against the live API with `just verify-models`.
# High-volume per-chunk entity/relation extraction.
MISTRAL_EXTRACTION_MODEL=mistral-small-latest
# Chat answers, folder level inference, query rewriting.
MISTRAL_CHAT_MODEL=mistral-large-latest
# Embeddings. Must match EMBEDDING_DIMENSIONS and the Neo4j vector index.
MISTRAL_EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024
# Chunks per embedding request, capped by count and by combined length. The API rejects
# a request over a total token budget ("Too many tokens overall"), which a count alone
# cannot prevent; characters stand in for tokens.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_CHARACTERS=64000

# --- Entity traversal retrieval leg ------------------------------------------
# The entities named in a question are matched into the graph by normalised name and
# by embedding; this is the floor the embedding half must clear. Short names embed
# close together, so the usable band is narrow and measured — see "the entity traversal
# leg" in the README for the pairs behind it:
#   must stay at or below 0.9065 ('Vogt'/'Dr. Katharina Vogt' — a real match)
#   must stay above       0.9001 ('Prüfschema Berechtigungsrollen'/'Berechtigungskonzept
#                                 Patientendaten' — a different artefact)
# Too low and the walk starts from the wrong node and answers confidently out of
# genuinely connected material about something nobody asked after.
TRAVERSAL_MATCH_THRESHOLD=0.905
# Graph entities considered per question entity before the threshold is applied.
TRAVERSAL_CANDIDATES=5

# --- Ingestion cache ---------------------------------------------------------
# Where the result of every external call an ingest makes is kept: the parse of each
# PDF, each embedding, each model reply. Keyed by the file's content hash and by the
# configuration the call depended on, so a re-run over an unchanged corpus makes no API
# calls at all and a changed document is the only one reprocessed. Disposable — delete
# it and the next ingest is simply slow. `ingest --no-cache` empties it first.
CACHE_DIR=.cache/ingest

# --- HTTP service ------------------------------------------------------------
# `just serve`. The frontend calls this from the browser, so the origins it is allowed
# to call from are configuration rather than a constant: during development Vite serves
# the UI on its own port, and a demo machine where that port differs otherwise fails
# with an error visible only in the browser console.
#
# The demo itself does not use them. `just demo` serves the built bundle from
# FRONTEND_DIST at `/`, so the browser calls /api/ask on the origin it was loaded from
# and cross-origin never enters the picture. A missing directory is not an error: the
# service is perfectly usable with no UI.
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=frontend/dist

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphragdemo
NEO4J_DATABASE=neo4j
# Host ports published by docker compose. If you change NEO4J_BOLT_PORT to avoid a clash
# with another local Neo4j, change the port in NEO4J_URI above to match — nothing derives
# one from the other.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Unstructured ------------------------------------------------------------
# Self-hosted parsing service, started by the monorepo's process-compose.
UNSTRUCTURED_URL=http://localhost:8100
# Layout-aware parsing. hi_res is what production uses; German first for OCR hints.
PARSING_STRATEGY=hi_res
PARSING_LANGUAGES=deu,eng
PARSING_IMAGE_BLOCK_TYPES=Image,Table
PARSING_TIMEOUT_SECONDS=1800
PARSING_MAX_RETRIES=2
# Documents parsed at once. Parsing dominates ingest wall-clock; raise it if the
# self-hosted service has headroom, lower it to 1 to make failures easier to read.
PARSING_CONCURRENCY=4

# --- Chunking ----------------------------------------------------------------
# Vendored from the production ingestion service and tuned for German, which is
# token-dense (~3-4 characters per token from compound words). Changing these
# decouples demo chunk boundaries from production ones.
CHUNK_STRATEGY=by_title
CHUNK_MAX_CHARACTERS=2000
CHUNK_NEW_AFTER_N_CHARS=1600
CHUNK_COMBINE_UNDER_N_CHARS=500
CHUNK_OVERLAP=250

# --- Document summaries ------------------------------------------------------
# One chat-tier call per document at ingestion time, cached by the document's content
# hash. Sections of the document are drawn evenly across it rather than from its front:
# every report in this corpus opens with the same boilerplate, so a front-loaded excerpt
# would summarise the template instead of the document.
SUMMARY_EXCERPT_CHUNKS=10
SUMMARY_EXCERPT_CHARACTERS=8000
# Cap on the stored summary; it is read back into a later answer's context budget.
SUMMARY_MAX_CHARACTERS=1200
SUMMARY_CONCURRENCY=4

# --- Entity extraction and resolution ----------------------------------------
# One extraction-tier call per chunk — the high-volume call site in the system and the
# main cost of an ingest. Raise the concurrency if the API has headroom.
ENTITY_CONCURRENCY=8
# Cap on a stored evidence span. Evidence is read back into an answer's context and
# rendered on an edge in the UI, so a whole paragraph costs both.
ENTITY_EVIDENCE_CHARACTERS=300
# Resolution thresholds, measured against the generated corpus — see "Entities and
# relations" in the README for the pairs behind these numbers. Above the merge
# threshold two names are one entity; below the review threshold they are two; the band
# between goes to the chat-tier model, one call per pair.
#   merge  must stay above 0.9013 ('Schnittstellenverzeichnis'/'Schnittstellenverträge')
#   review must stay below 0.7990 ('Vektor Consulting GmbH'/'Vektor Con')
ENTITY_MERGE_THRESHOLD=0.92
ENTITY_REVIEW_THRESHOLD=0.75
# Whether the band is put to the model at all. Off leaves band pairs unmerged — visible
# as two nodes rather than quietly fused — which is the safe way to run without a key.
ENTITY_ADJUDICATION=1
